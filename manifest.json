{
  "manifest_version": 3,
  "name": "OLJ Info Extractor",
  "version": "0.1.0",
  "description": "Extract header and body text from the current page.",
  "action": {
    "default_title": "Extract page info",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
